graph DeliveryRings {
  graph [
    layout=neato,
    overlap=true,
    splines=false,
    outputorder=edgesfirst,
    bgcolor="#FFFFFF",
    margin=0.08,
    pad=0.25,
    labelloc=t,
    label="Figure 11 - Concentric delivery rings",
    fontsize=18,
    fontname="Arial"
  ];

  node [
    shape=circle,
    fixedsize=true,
    label="",
    color="#374151",
    penwidth=2.0,
    pin=true
  ];

  r5 [width=9.2, height=9.2, pos="0,0!"];
  r4 [width=7.6, height=7.6, pos="0,0!"];
  r3 [width=6.0, height=6.0, pos="0,0!"];
  r2 [width=4.5, height=4.5, pos="0,0!"];
  r1 [width=3.0, height=3.0, pos="0,0!"];
  r0 [width=1.55, height=1.55, pos="0,0!", style=filled, fillcolor="#F3F4F6"];

  node [
    shape=plain,
    fixedsize=false,
    pin=true,
    fontname="Arial",
    fontcolor="#111827",
    fontsize=12
  ];

  t0 [label=<<B>R0</B><BR/>Deployable hollow shell>, pos="0,0!"];
  t1 [label=<<B>R1</B>  Mandatory synthetic customer review>, pos="0,1.15!"];
  t2 [label=<<B>R2</B>  Relational substitution>, pos="0,1.90!"];
  t3 [label=<<B>R3</B>  Mandatory analysis + history>, pos="0,2.65!"];
  t4 [label=<<B>R4</B>  MUST_HAVE auth + RAG closure>, pos="0,3.40!"];
  t5 [label=<<B>R5</B>  Hardening + demo>, pos="0,4.20!"];

  invariant [
    label=<<B>Invariant</B>: same application core · stable ports · adapters activated/substituted concentrically>,
    pos="0,-4.20!"
  ];

  node [shape=plain, pin=true, fontname="Arial", fontsize=11, fontcolor="#111827"];
  legend_title [label=<<B>Legend</B>>, pos="6.35,3.80!"];
  legend_r0 [label=<<B>R0</B>  Java/Spring/React shell; project-owned contracts and ports>, pos="6.35,3.30!"];
  legend_r1 [label=<<B>R1</B>  MANDATORY customer search + activity + risk on synthetic data>, pos="6.35,2.70!"];
  legend_r2 [label=<<B>R2</B>  Spring JDBC/PostgreSQL/Flyway/Testcontainers behind CustomerActivityPort>, pos="6.35,2.10!"];
  legend_r3 [label=<<B>R3</B>  MANDATORY structured analysis + persistent reviewable history>, pos="6.35,1.50!"];
  legend_r4 [label=<<B>R4</B>  MUST_HAVE authentication + RAG + trust boundaries>, pos="6.35,0.90!"];
  legend_r5 [label=<<B>R5</B>  Reliability, observability, NICE_TO_HAVE and demo polish>, pos="6.35,0.30!"];

  reading_1 [label="Requirement priority determines first acceptance; structural seams may exist earlier.", pos="6.35,-0.75!"];
  reading_2 [label="R2 substitutes infrastructure without inventing a new user-visible use case.", pos="6.35,-1.20!"];
  reading_3 [label="Each outer ring encloses and extends the same architecture.", pos="6.35,-1.65!"];
}
