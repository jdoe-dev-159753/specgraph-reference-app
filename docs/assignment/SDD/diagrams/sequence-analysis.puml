@startuml
title Figure 7a — Staged evidence-to-analysis orchestration
hide footbox
skinparam maxMessageSize 50

actor Operator
participant "React UI" as UI
participant "Spring Security +\nAnalysis HTTP adapter" as Boundary
participant "OperatorContextPort" as OperatorContext
participant "Analysis\napplication" as Analysis
participant "CustomerActivityPort" as Activity
participant "RiskSignalDetectorPort" as Detector
participant "PolicyKnowledgePort" as Policy
participant "AnalysisContextBuilder" as ContextBuilder
participant "AnalysisModelPort" as Model
participant "AnalysisHistoryPort" as History

Operator -> UI : Analyze selected customer
UI -> Boundary : POST protected analysis request + CSRF
Boundary -> OperatorContext : requireAuthenticated()
alt unauthenticated
  OperatorContext --> Boundary : rejection
  Boundary --> UI : HTTP 401
  UI --> Operator : authentication required
else authenticated
  OperatorContext --> Boundary : OperatorId
  Boundary -> Analysis : analyze(customerId, OperatorId)
  Analysis -> Activity : loadSnapshot(customerId)
  Activity --> Analysis : complete CustomerSnapshot\n(source facts + source risk evidence)

  Analysis -> Detector : detect(complete snapshot)
  alt detector failure
    Detector --> Analysis : failure
    Analysis --> Boundary : explicit detector failure
    Boundary --> UI : not completed / retained
  else detector succeeds
    Detector --> Analysis : RiskSignalEvidence[]\n(default no-op => [])
    Analysis -> Policy : retrieveRelevant(complete snapshot)

    alt no relevant policy evidence
      Policy --> Analysis : explicit no-evidence
      Analysis --> Boundary : insufficient grounding
      Boundary --> UI : not presented as grounded/completed
    else relevant evidence available
      Policy --> Analysis : PolicyEvidence[]
      Analysis -> ContextBuilder : build(snapshot, detector, policy)
      ContextBuilder --> Analysis : AnalysisEvidenceEnvelope\nexact totals + bounded selected details
      Analysis -> Model : analyze(bounded evidenceEnvelope)
      alt model/provider failure
        Model --> Analysis : failure
        Analysis --> Boundary : explicit analysis failure
        Boundary --> UI : not completed / retained
      else candidate returned
        Model --> Analysis : AnalysisModelOutput\n(result + model provenance)
        Analysis -> Analysis : validate structured AnalysisResult\n+ references against supplied bounded evidence
        alt invalid structured result
          Analysis --> Boundary : validation failure
          Boundary --> UI : invalid result not retained
        else valid result
          Analysis -> History : persist(result + operator + policy/detector/model provenance)
          alt persistence failure
            History --> Analysis : failure
            Analysis --> Boundary : explicit persistence failure
            Boundary --> UI : not represented as retained/completed
          else persistence succeeds
            History --> Analysis : AnalysisHistoryEntry
            Analysis --> Boundary : completed structured analysis
            Boundary --> UI : risk + findings + recommendations\n+ layered provenance
            UI --> Operator : review completed analysis
          end
        end
      end
    end
  end
end

note over Activity,ContextBuilder
  Stage 1 detector and Stage 2 policy retrieval retain complete CustomerSnapshot semantics.
  AnalysisContextBuilder is the application-owned cut immediately before the model port:
  full-history aggregates stay exact while model-facing details are deterministically bounded.
end note

note over OperatorContext,History
  OperatorContextPort is project-owned; Spring Security types stop at its adapter.
  The remaining participants are application ports/contracts. RAG is the
  PolicyKnowledgePort stage, not the complete analysis architecture.
end note
@enduml
