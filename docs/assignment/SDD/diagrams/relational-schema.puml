@startuml
title Figure 5 — Relational persistence model
top to bottom direction
hide methods
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40

package "Source activity / risk relations" <<SRC-001>> {
  entity transactions {
    * transaction_id : UUID <<PK>>
    --
    customer_id : UUID <<FK>>
    activity_type : CARD|PAYMENT|CRYPTO
    amount
    currency
    status
    created_at
  }
  entity card_activity {
    * transaction_id : UUID <<PK,FK>>
    --
    masked_pan
    card_type
    merchant / mcc
    card_present
    authorization_code
    decline_reason [optional]
  }
  entity payment_activity {
    * transaction_id : UUID <<PK,FK>>
    --
    payment_method
    sender_account
    receiver_account
    receiver_bank_country
  }
  entity crypto_activity {
    * transaction_id : UUID <<PK,FK>>
    --
    blockchain
    source_wallet
    destination_wallet
    transaction_hash
    exchange_name [optional]
  }
  entity risk_rules {
    * source rule key
    --
    name
    applicable_activity_family
    threshold_logic
    default_weight
  }
  entity risk_assessments {
    * source assessment key
    --
    transaction reference <<FK>>
    risk_rule reference <<FK>>
    trigger_time
    score_contribution
  }

  transactions ||--o| card_activity : CARD
  transactions ||--o| payment_activity : PAYMENT
  transactions ||--o| crypto_activity : CRYPTO
  transactions ||--o{ risk_assessments : evidence
  risk_rules ||--o{ risk_assessments : triggered rule

  card_activity -[hidden]down-> payment_activity
  payment_activity -[hidden]down-> crypto_activity
  risk_rules -[hidden]down-> risk_assessments
}

package "Project-owned persistence extensions" {
  entity customers <<ASM-DATA-001>> {
    * customer_id : UUID <<PK>>
  }
  entity analysis_history <<ASM-HIST-001>> {
    * analysis_id : UUID <<PK>>
    --
    customer_id : UUID
    operator_id : project identity value
    generated_at : timestamp
    risk_level : LOW|MEDIUM|HIGH
    findings_summary : text
    recommendations : JSONB
    evidence_provenance : JSONB
    provider_provenance : JSONB
  }

  customers ||--o{ analysis_history : history
}

customers ||--o{ transactions : owns

note bottom
  Exact SRC-001 DDL remains authoritative outside the durable repository.
  Attribute labels follow the SRS source-schema summary; unspecified source
  PK/FK names are intentionally not invented. analysis_history is the minimal
  project-owned extension permitted by ASM-HIST-001. R4 policy-chunk/pgvector
  physical shape remains deferred by AMB-RAG-001.
end note
@enduml
