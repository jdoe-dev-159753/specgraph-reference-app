@startuml
title Figure 4 — Project-owned domain contracts and source mappings
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40

package "Source persistence concepts" {
  class Transaction <<source relation>> {
    transaction_id : UUID
    customer_id : UUID
    activity_type : CARD|PAYMENT|CRYPTO
    amount
    currency
    status
    created_at
  }
  class CardActivity <<source specialization>>
  class PaymentActivity <<source specialization>>
  class CryptoActivity <<source specialization>>
  class RiskAssessment <<source relation>> {
    triggeredAt
    scoreContribution
  }
  class RiskRule <<source relation>> {
    name
    applicableActivityFamily
    thresholdLogic
    defaultWeight
  }

  Transaction <|-- CardActivity : CARD detail
  Transaction <|-- PaymentActivity : PAYMENT detail
  Transaction <|-- CryptoActivity : CRYPTO detail
  Transaction "1" -- "0..*" RiskAssessment
  RiskRule "1" -- "0..*" RiskAssessment

  CardActivity -[hidden]down-> PaymentActivity
  PaymentActivity -[hidden]down-> CryptoActivity
  RiskRule -[hidden]down-> RiskAssessment
}

package "Project-owned contracts" {
  class CustomerSnapshot <<project contract>> {
    customerIdentity
    activities : ActivityProjection[*]
    riskEvidence : RiskEvidence[*]
  }
  class ActivityProjection <<project contract>> {
    transactionId
    family : CARD|PAYMENT|CRYPTO
    amount
    currency
    status
    occurredAt
    familyDetails
  }
  class RiskEvidence <<project contract>> {
    transactionId
    ruleIdentity
    ruleName
    triggeredAt
    scoreContribution
  }
  class AnalysisResult <<project contract>> {
    riskLevel : LOW|MEDIUM|HIGH
    findingsSummary
    recommendations
  }
  class PolicyEvidence <<project contract>> {
    sourceIdentity
    content
    retrievalMetadata
  }
  class OperatorId <<project value>> {
    operatorIdentity
  }
  class AnalysisHistoryCreateCommand <<project command>> {
    customerIdentity
    operatorIdentity : OperatorId
    generatedAt
    result : AnalysisResult
    evidenceProvenance : PolicyEvidence[*]
  }
  class AnalysisHistoryEntry <<project contract>> {
    analysisIdentity
    customerIdentity
    operatorIdentity : OperatorId
    generatedAt
    result : AnalysisResult
    evidenceProvenance : PolicyEvidence[*]
  }

  CustomerSnapshot "1" o-- "0..*" ActivityProjection
  CustomerSnapshot "1" o-- "0..*" RiskEvidence
  AnalysisHistoryCreateCommand "1" *-- "1" AnalysisResult
  AnalysisHistoryCreateCommand "1" --> "1" OperatorId
  AnalysisHistoryCreateCommand "1" o-- "0..*" PolicyEvidence
  AnalysisHistoryEntry ..> AnalysisHistoryCreateCommand : persisted form + generated identity
  AnalysisHistoryEntry "1" *-- "1" AnalysisResult
  AnalysisHistoryEntry "1" --> "1" OperatorId
  AnalysisHistoryEntry "1" o-- "0..*" PolicyEvidence

  ActivityProjection -[hidden]right-> RiskEvidence
  AnalysisResult -[hidden]right-> PolicyEvidence
}

Transaction ..> ActivityProjection : adapter mapping
CardActivity ..> ActivityProjection : family details
PaymentActivity ..> ActivityProjection : family details
CryptoActivity ..> ActivityProjection : family details
RiskAssessment ..> RiskEvidence : evidence mapping
RiskRule ..> RiskEvidence : rule identity/name
AnalysisResult ..> CustomerSnapshot : derived from context
AnalysisResult ..> PolicyEvidence : grounded by evidence

note bottom of Transaction
  Source-schema concepts stop at the adapter boundary. Project contracts contain
  only project-owned projections; JPA/source relation types never become durable
  application-contract members.
end note
@enduml
