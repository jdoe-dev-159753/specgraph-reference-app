@startuml
title Supplementary Figure S1 — Comprehensive failure and degraded behavior
hide footbox
actor Operator
participant "React UI" as UI
participant "Security / HTTP boundary" as Boundary
participant "analysis application" as Analysis
participant "PolicyKnowledgePort" as Policy
participant "AnalysisModelPort" as Model
participant "AnalysisHistoryPort" as History

== Authentication / selection ==
Operator -> UI : protected action
UI -> Boundary : request
alt unauthenticated
  Boundary --> UI : reject / redirect
  UI --> Operator : authentication required
else authenticated
  Boundary -> Analysis : continue with OperatorId

  == Grounding ==
  Analysis -> Policy : retrieveRelevant(context)
  alt no relevant evidence
    Policy --> Analysis : explicit no-evidence
    Analysis -> Analysis : record insufficient grounding; never fabricate provenance
    Analysis --> Boundary : insufficient-grounding outcome
    Boundary --> UI : explicit outcome, not successfully grounded
    UI --> Operator : insufficient grounding
    note right of Analysis
      AC-RAG-002 ends this grounded-request flow without a
      successfully grounded completed analysis. AMB-RAG-001
      still leaves minimum evidence unspecified; a future,
      explicitly defined ungrounded mode would require its own
      reviewed semantics rather than falling through here.
    end note
  else relevant evidence retrieved
    Policy --> Analysis : PolicyEvidence[] with provenance

    == Model execution / validation ==
    Analysis -> Model : analyze(context, evidence)
    alt provider/execution failure
      Model --> Analysis : failure
      Analysis --> Boundary : explicit analysis failure
    else candidate result
      Model --> Analysis : structured candidate
      Analysis -> Analysis : validate contract
      alt invalid result
        Analysis --> Boundary : explicit validation failure; do not persist
      else valid result
        Analysis -> History : persist completed result
        alt persistence failure
          History --> Analysis : failure
          Analysis --> Boundary : explicit persistence failure
          note right: do not claim retained history
        else persistence succeeds
          History --> Analysis : persisted
          Analysis --> Boundary : completed result
        end
      end
    end
    Boundary --> UI : explicit success/failure outcome
    UI --> Operator : completed result or named failure state
  end
end
@enduml
