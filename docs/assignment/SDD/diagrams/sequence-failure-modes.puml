@startuml
hide footbox
actor Operator
participant "React UI" as UI
participant "Security / HTTP boundary" as Boundary
participant "analysis application" as Analysis
participant "PolicyKnowledgePort" as Policy
participant "AnalysisModelPort" as Model
participant "AnalysisHistoryPort" as History

== Authentication / selection ==
Operator -> UI : protected action
UI -> Boundary : request
alt unauthenticated
  Boundary --> UI : reject / redirect
else authenticated
  Boundary -> Analysis : continue with OperatorId
end

== Grounding insufficiency ==
Analysis -> Policy : retrieveRelevant(context)
Policy --> Analysis : no relevant evidence
Analysis -> Analysis : record no-evidence; never fabricate provenance
note right of Analysis
  AMB-RAG-001 still controls whether an explicitly
  ungrounded analysis may complete. The SDD does not
  silently turn insufficiency into fake grounding.
end note

== Model execution / validation ==
Analysis -> Model : analyze(context, evidence state)
alt provider/execution failure
  Model --> Analysis : failure
  Analysis --> Boundary : explicit analysis failure
else candidate result
  Model --> Analysis : structured candidate
  Analysis -> Analysis : validate contract
  alt invalid result
    Analysis --> Boundary : explicit validation failure; do not persist
  else valid result
    Analysis -> History : persist completed result
    alt persistence failure
      History --> Analysis : failure
      Analysis --> Boundary : explicit persistence failure;
      note right: do not claim retained history
    else persistence succeeds
      History --> Analysis : persisted
      Analysis --> Boundary : completed result
    end
  end
end
Boundary --> UI : explicit outcome
UI --> Operator : success or named failure state
@enduml
