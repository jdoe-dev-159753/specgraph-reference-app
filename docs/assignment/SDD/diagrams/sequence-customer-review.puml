@startuml
title Figure 5 — Authenticated customer review
hide footbox
skinparam maxMessageSize 52

actor Operator
participant "React UI" as UI
participant "Security + HTTP\nboundary" as Boundary
participant "Customer / Risk\napplication" as App
participant "CustomerActivityPort" as Port
participant "Activity adapter" as Adapter
database "PostgreSQL" as DB

Operator -> UI : authenticate + enter Customer ID
UI -> Boundary : protected GET [HTTP/JSON]
alt unauthenticated
  Boundary --> UI : 401 / redirect
  UI --> Operator : authentication required
else authenticated
  Boundary -> App : lookup(customerId, operator) [in-process]
  App -> Port : loadSnapshot(customerId)
  alt R1 synthetic adapter
    Port -> Adapter : SyntheticActivityAdapter.loadSnapshot
    Adapter --> Port : CustomerSnapshot / not-found
  else R2+ relational adapter
    Port -> Adapter : JpaCustomerActivityAdapter.loadSnapshot
    Adapter -> DB : JDBC activity + risk queries
    DB --> Adapter : source rows
    Adapter --> Port : CustomerSnapshot / not-found
  end

  alt customer exists
    Port --> App : CustomerSnapshot
    App --> Boundary : activity + risk projection
    Boundary --> UI : 200 JSON
    UI --> Operator : CARD / PAYMENT / CRYPTO + risk evidence
  else unknown Customer ID
    Port --> App : not-found
    App --> Boundary : explicit not-found
    Boundary --> UI : 404
    UI --> Operator : customer not found
  end
end
@enduml
