@startuml
hide footbox
actor Operator
participant "React UI" as UI
participant "Spring Security\nboundary" as Auth
participant "HTTP adapter" as Http
participant "customer/risk\napplication" as App
participant "CustomerActivityPort" as Port
participant "SyntheticActivityAdapter" as Stub
participant "JpaCustomerActivityAdapter" as Jpa
database "PostgreSQL" as DB

Operator -> UI : authenticate and enter Customer ID
UI -> Auth : protected HTTP request
alt unauthenticated
  Auth --> UI : 401/redirect; no customer capability
else authenticated
  Auth -> Http : operator context + request
  Http -> App : lookup(customerId) [in-process]
  App -> Port : loadSnapshot(customerId) [in-process]
  alt R1 synthetic path
    Port -> Stub : loadSnapshot(customerId)
    Stub --> Port : CustomerSnapshot / not-found
  else R2+ relational path
    Port -> Jpa : loadSnapshot(customerId)
    Jpa -> DB : JDBC / PostgreSQL queries
    DB --> Jpa : transaction + specialization + risk rows
    Jpa --> Port : CustomerSnapshot / not-found
  end
  alt customer exists
    Port --> App : CustomerSnapshot
    App --> Http : customer/activity/risk projection
    Http --> UI : 200 JSON dashboard data
    UI --> Operator : CARD/PAYMENT/CRYPTO + risk evidence
  else unknown Customer ID
    Port --> App : not-found
    App --> Http : explicit not-found
    Http --> UI : 404 / domain not-found response
    UI --> Operator : customer not found; no fabrication
  end
end
@enduml
