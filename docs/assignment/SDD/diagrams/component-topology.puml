@startuml
title Figure 3 — UML Component diagram — application components and interfaces
top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 38
skinparam ranksep 45

actor "Customer Care\nOperator" as Operator
interface "Protected HTTP/JSON API" as WebApi

package "Web client" {
  component "Operator Dashboard\nCMP-UI-001\nReact / TypeScript" as UI
}

package "Spring Boot modular monolith" as Backend {
  component "Spring Security Boundary\nADP-AUTH-SPRING-001\nMUST_HAVE activation" as Auth
  component "HTTP Adapter\nADP-HTTP-001\n<<GoF Adapter>>" as Http

  component "Identity Module\nMOD-IDENTITY-001" as Identity
  component "Customer Module\nMOD-CUSTOMER-001" as Customer
  component "Risk Module\nMOD-RISK-001" as Risk
  component "Analysis Module\nMOD-ANALYSIS-001\napplication-service facade" as Analysis

  interface "CustomerActivityPort\nPRT-ACTIVITY-001\n<<Strategy seam>>" as ActivityPort
  interface "PolicyKnowledgePort\nPRT-POLICY-001\n<<Strategy seam>>" as PolicyPort
  interface "AnalysisModelPort\nPRT-MODEL-001\n<<Strategy seam>>" as ModelPort
  interface "AnalysisHistoryPort\nPRT-HISTORY-001" as HistoryPort

  Identity -[hidden]right-> Customer
  Customer -[hidden]right-> Risk
  Risk -[hidden]right-> Analysis

  ActivityPort -[hidden]right-> PolicyPort
  ModelPort -[hidden]right-> HistoryPort
  ActivityPort -[hidden]down-> ModelPort
  PolicyPort -[hidden]down-> HistoryPort
}

package "Replaceable adapters" as Adapters {
  component "Synthetic Activity\nADP-ACT-SYN-001\nR0/R1\n<<GoF Adapter>>" as ActivitySynthetic
  component "JPA Activity\nADP-ACT-JPA-001\nR2\n<<GoF Adapter>>" as ActivityJpa
  component "Static Policy\nADP-POL-STATIC-001\npre-R4 seam\n<<GoF Adapter>>" as PolicyStatic
  component "pgvector Policy\nADP-POL-PGV-001\nR4\n<<GoF Adapter>>" as PolicyPg
  component "Deterministic Model\nADP-MODEL-DET-001\nR0/R3\n<<GoF Adapter>>" as ModelDet
  component "Spring AI Model\nADP-MODEL-AI-001\nR4 optional\n<<GoF Adapter>>" as ModelAi
  component "JPA Analysis History\nADP-HIST-JPA-001\nR4\n<<GoF Adapter>>" as HistoryJpa

  ActivitySynthetic -[hidden]right-> ActivityJpa
  ActivityJpa -[hidden]right-> PolicyStatic
  PolicyStatic -[hidden]right-> PolicyPg
  ModelDet -[hidden]right-> ModelAi
  ModelAi -[hidden]right-> HistoryJpa
}

component "PostgreSQL + pgvector\nINF-DB-001\nR2+" as Db <<database>>
component "External AI provider" as Provider <<external>>

Operator --> UI
UI --> WebApi : HTTP/JSON
WebApi --> Http : provided by
Auth --> Http : operator context when R4 activated
Auth --> Identity
Http --> Customer
Http --> Risk
Http --> Analysis : coarse-grained use case

Customer --> ActivityPort
Risk --> ActivityPort
Analysis --> ActivityPort : customer context
Analysis --> PolicyPort
Analysis --> ModelPort
Analysis --> HistoryPort

ActivityPort --> ActivitySynthetic
ActivityPort ..> ActivityJpa
PolicyPort --> PolicyStatic
PolicyPort ..> PolicyPg
ModelPort --> ModelDet
ModelPort ..> ModelAi
HistoryPort ..> HistoryJpa

ActivityJpa --> Db : JDBC
PolicyPg --> Db : JDBC / pgvector
HistoryJpa --> Db : JDBC
ModelAi ..> Provider : HTTPS

note bottom of Backend
  UML Component diagram: components and provided/required interfaces show structural
  dependencies. GoF Adapter labels identify boundary translation roles; Strategy seams
  identify ports with interchangeable implementations; the analysis application service
  acts as a Facade over orchestration. Structural presence does not imply first acceptance:
  authentication is activated with the MUST_HAVE ring, not the mandatory R1 slice.
end note
@enduml
