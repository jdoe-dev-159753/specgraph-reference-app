@startuml
title Figure 3 — Component topology and application interfaces
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45

actor "Customer Care\nOperator" as Operator
interface "Protected\nHTTP/JSON API" as WebApi

package "Web client" {
  component "Operator Dashboard\nCMP-UI-001\nReact / TypeScript" as UI
}

package "Spring Boot modular monolith" as Backend {
  component "Spring Security\nBoundary\nADP-AUTH-SPRING-001" as Auth
  component "HTTP Adapter\nADP-HTTP-001" as Http

  together {
    component "Identity Module\nMOD-IDENTITY-001" as Identity
    component "Customer Module\nMOD-CUSTOMER-001" as Customer
    component "Risk Module\nMOD-RISK-001" as Risk
    component "Analysis Module\nMOD-ANALYSIS-001" as Analysis
  }

  together {
    interface "CustomerActivityPort\nPRT-ACTIVITY-001" as ActivityPort
    interface "PolicyKnowledgePort\nPRT-POLICY-001" as PolicyPort
    interface "AnalysisModelPort\nPRT-MODEL-001" as ModelPort
    interface "AnalysisHistoryPort\nPRT-HISTORY-001" as HistoryPort
  }
}

package "Replaceable adapters" as Adapters {
  together {
    component "Synthetic Activity\nADP-ACT-SYN-001\nR0/R1" as ActivitySynthetic
    component "JPA Activity\nADP-ACT-JPA-001\nR2" as ActivityJpa
  }
  together {
    component "Static Policy\nADP-POL-STATIC-001\nR0" as PolicyStatic
    component "pgvector Policy\nADP-POL-PGV-001\nR4" as PolicyPg
  }
  together {
    component "Deterministic Model\nADP-MODEL-DET-001\nR0/R3" as ModelDet
    component "Spring AI Model\nADP-MODEL-AI-001\nR4 optional" as ModelAi
  }
  component "JPA Analysis History\nADP-HIST-JPA-001\nR3" as HistoryJpa
}

database "PostgreSQL + pgvector\nINF-DB-001\nR2+" as Db

Operator --> UI
UI --> WebApi : HTTP/JSON
WebApi -- Http : provided by
Auth --> Http : operator context
Auth --> Identity
Http --> Customer
Http --> Risk
Http --> Analysis

Customer --> ActivityPort
Risk --> ActivityPort
Analysis --> ActivityPort : customer context
Analysis --> PolicyPort
Analysis --> ModelPort
Analysis --> HistoryPort

ActivityPort --> ActivitySynthetic
ActivityPort ..> ActivityJpa
PolicyPort --> PolicyStatic
PolicyPort ..> PolicyPg
ModelPort --> ModelDet
ModelPort ..> ModelAi
HistoryPort ..> HistoryJpa

ActivityJpa --> Db : JDBC
PolicyPg --> Db : JDBC / pgvector
HistoryJpa --> Db : JDBC

note bottom of Backend
  Project-owned ports are the stable application seams.
  Spring/JPA/provider types remain adapter-side implementation details.
end note
@enduml
