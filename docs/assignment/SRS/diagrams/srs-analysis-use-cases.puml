@startuml
left to right direction
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor<<MANDATORY>> #FFB3B3
  BackgroundColor<<MUST_HAVE>> #FFD699
}

actor "Customer Care Operator" as Operator

rectangle "Customer Activity Analytics" as SystemBoundary {
  package "AI-assisted analysis" {
    usecase "Request AI Analysis\n[FR-AI-001]" as UC_Request <<MANDATORY>>
    usecase "Build Customer Analysis Context" as UC_Context <<MANDATORY>>
    usecase "Retrieve Relevant Policy Knowledge\n[FR-RAG-001]" as UC_RAG <<MUST_HAVE>>
    usecase "Produce Structured Risk Analysis\n[FR-AI-002]" as UC_Result <<MANDATORY>>
    usecase "Persist Completed Analysis\n[FR-HIST-001]" as UC_Persist <<MUST_HAVE>>
  }

  package "Analysis history" {
    usecase "Review Previous Analyses\n[FR-HIST-002]" as UC_History <<MUST_HAVE>>
  }

  UC_Request .> UC_Context : <<include>>
  UC_Request .> UC_RAG : <<include>>
  UC_Result .> UC_Request : <<extend>>\n[grounding sufficient]
  UC_Persist .> UC_Result : <<extend>>\n[valid result produced]

  UC_Context -[hidden]-> UC_RAG
  UC_RAG -[hidden]-> UC_Result
  UC_Result -[hidden]-> UC_Persist
}

Operator -- UC_Request
Operator -- UC_History

note right of UC_Result
  Structured result contract:
  * risk level
  * non-empty findings summary
  * one or more recommendations
end note

note bottom of UC_Request
  Protected capability.
  Context construction and grounding retrieval are always attempted.
  Structured production and persistence are conditionally reached
  only after their stated success conditions are satisfied.
end note

note right of UC_RAG
  Retrieved policy evidence must be real corpus evidence;
  absence or provider failure must not be disguised as
  successful grounding.
end note

legend bottom
  |= Colour |= Delivery priority |
  |<#FFB3B3> | MANDATORY |
  |<#FFD699> | MUST_HAVE |
endlegend
@enduml
