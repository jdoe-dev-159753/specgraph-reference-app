@startuml
title Customer Activity Analytics — illustrative functional use cases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor "Customer Care Operator" as Operator

skinparam usecase {
  BackgroundColor<<MANDATORY>> #FFB3B3
  BackgroundColor<<MUST_HAVE>> #FFD699
  BackgroundColor<<NICE_TO_HAVE>> #CDECCF
}

rectangle "Customer Risk Analysis Reference Application\n<<system boundary>>" as SystemBoundary {
  package "Identity and customer selection" {
    usecase "Authenticate Operator\n[FR-AUTH-001]" as UC_Auth <<MUST_HAVE>>
    usecase "Search Customer\n[FR-CUST-001]" as UC_Search <<MANDATORY>>
  }

  package "Customer activity review" {
    usecase "Review Customer Dashboard\n[FR-ACT-001]" as UC_Dashboard <<MANDATORY>>
    usecase "Review Customer Activity\n[FR-ACT-001]" as UC_Activity <<MANDATORY>>
    usecase "Review CARD Activity\n[FR-ACT-002]" as UC_Card <<MANDATORY>>
    usecase "Review PAYMENT Activity\n[FR-ACT-002]" as UC_Payment <<MANDATORY>>
    usecase "Review CRYPTO Activity\n[FR-ACT-002]" as UC_Crypto <<MANDATORY>>
    usecase "Filter Activity" as UC_Filter <<NICE_TO_HAVE>>
    usecase "Inspect Transaction Details" as UC_Detail <<NICE_TO_HAVE>>
  }

  package "Risk evidence review" {
    usecase "Review Risk Signals\n[FR-RISK-001]" as UC_Risk <<MANDATORY>>
  }

  package "AI-assisted customer analysis" {
    usecase "Request AI Analysis\n[FR-AI-001]" as UC_AI <<MANDATORY>>
    usecase "Build Analysis Context" as UC_Context <<MANDATORY>>
    usecase "Produce Structured Risk Analysis\n[FR-AI-002]" as UC_Assessment <<MANDATORY>>
    usecase "Ground Analysis with Relevant Policies\n[FR-RAG-001]" as UC_Grounded <<MUST_HAVE>>
    usecase "Retain Analysis for Later Review\n[FR-HIST-001]" as UC_Retain <<MUST_HAVE>>
  }

  package "Analysis history review" {
    usecase "Review Analysis History\n[FR-HIST-002]" as UC_History <<MUST_HAVE>>
  }

  UC_Dashboard .> UC_Activity : <<include>>
  UC_Dashboard .> UC_Risk : <<include>>

  UC_Card -|> UC_Activity
  UC_Payment -|> UC_Activity
  UC_Crypto -|> UC_Activity

  UC_AI .> UC_Context : <<include>>
  UC_AI .> UC_Assessment : <<include>>
  UC_AI .> UC_Grounded : <<include>>
  UC_AI .> UC_Retain : <<include>>

  UC_Filter .> UC_Activity : <<extend>>
  UC_Detail .> UC_Activity : <<extend>>
}

Operator -- UC_Auth
Operator -- UC_Search
Operator -- UC_Dashboard
Operator -- UC_AI
Operator -- UC_History

note right of UC_Auth
  Completed-system precondition for protected use cases.
  MUST_HAVE priority means authentication is activated after
  the mandatory centre; it is not an R1 acceptance gate.
end note

note bottom of UC_Activity
  CARD, PAYMENT and CRYPTO are specializations
  of the common activity-review behavior.
end note

note bottom of UC_Assessment
  Produces the mandatory risk level,
  findings summary and recommendations.
end note

legend bottom
  UML Package = logical namespace/grouping of coherent use cases.
  System boundary = subject to which the use cases apply; visual containment
  does not replace package ownership. Requirement IDs are traceability labels,
  not Requirement elements embedded in this UML use-case view.
endlegend
@enduml
