@startuml
left to right direction
actor "Customer Care Operator" as Operator

skinparam usecase {
  BackgroundColor<<MANDATORY>> #FFB3B3
  BackgroundColor<<MUST_HAVE>> #FFD699
  BackgroundColor<<NICE_TO_HAVE>> #CDECCF
}

rectangle "Customer Risk Analysis Reference Application" as SystemBoundary {
  usecase "Authenticate Operator" as UC_Auth <<MUST_HAVE>>
  usecase "Search Customer" as UC_Search <<MANDATORY>>
  usecase "Review Customer Dashboard" as UC_Dashboard <<MANDATORY>>

  usecase "Review Customer Activity" as UC_Activity <<MANDATORY>>
  usecase "Review CARD Activity" as UC_Card <<MANDATORY>>
  usecase "Review PAYMENT Activity" as UC_Payment <<MANDATORY>>
  usecase "Review CRYPTO Activity" as UC_Crypto <<MANDATORY>>
  usecase "Review Risk Signals" as UC_Risk <<MANDATORY>>

  usecase "Request AI Analysis" as UC_AI <<MANDATORY>>
  usecase "Build Analysis Context" as UC_Context <<MANDATORY>>
  usecase "Produce Structured Risk Analysis" as UC_Assessment <<MANDATORY>>
  usecase "Ground Analysis with Relevant Policies" as UC_Grounded <<MUST_HAVE>>
  usecase "Retain Analysis for Later Review" as UC_Retain <<MUST_HAVE>>
  usecase "Review Analysis History" as UC_History <<MUST_HAVE>>

  usecase "Filter Activity" as UC_Filter <<NICE_TO_HAVE>>
  usecase "Inspect Transaction Details" as UC_Detail <<NICE_TO_HAVE>>

  UC_Dashboard .> UC_Activity : <<include>>
  UC_Dashboard .> UC_Risk : <<include>>

  UC_Card -|> UC_Activity
  UC_Payment -|> UC_Activity
  UC_Crypto -|> UC_Activity

  UC_AI .> UC_Context : <<include>>
  UC_AI .> UC_Assessment : <<include>>
  UC_AI .> UC_Grounded : <<include>>
  UC_AI .> UC_Retain : <<include>>

  UC_Filter .> UC_Activity : <<extend>>
  UC_Detail .> UC_Activity : <<extend>>
}

Operator -- UC_Auth
Operator -- UC_Search
Operator -- UC_Dashboard
Operator -- UC_AI
Operator -- UC_History

note right of UC_Auth
  Precondition for protected use cases;
  not repeated as an <<include>> edge.
end note

note bottom of UC_Activity
  CARD, PAYMENT and CRYPTO are specializations
  of the common activity-review behavior.
end note

note bottom of UC_Assessment
  Produces the mandatory risk level,
  findings summary and recommendations.
end note

note bottom of UC_Grounded
  Delivery priority: MUST_HAVE.
  Priority does not determine UML relation semantics.
end note

note bottom of UC_Retain
  Delivery priority: MUST_HAVE.
  The completed target retains generated analyses.
end note
@enduml
