@startuml
left to right direction
actor "Developer / Reviewer" as Dev
actor "Customer Care Operator" as Operator
actor "Operations / Deployment" as Ops

skinparam usecase {
  BackgroundColor<<MANDATORY>> #FFB3B3
  BackgroundColor<<MUST_HAVE>> #FFD699
  BackgroundColor<<NICE_TO_HAVE>> #CDECCF
}

rectangle "Customer Risk Analysis Reference Application" as SystemBoundary {
  usecase "Reproduce System Locally" as NF_Reproduce <<MANDATORY>>
  usecase "Verify Change Deterministically" as NF_Verify <<MANDATORY>>
  usecase "Execute Analysis without External LLM" as NF_OfflineAI <<MANDATORY>>
  usecase "Enforce Operator Access Control" as NF_Access <<MUST_HAVE>>
  usecase "Persist and Reset Demo Data" as NF_Data <<MUST_HAVE>>
  usecase "Continue Safely on AI Failure" as NF_Degrade <<MUST_HAVE>>
  usecase "Expose Health / Readiness" as NF_Health <<MUST_HAVE>>
  usecase "Generate Technical / API Documentation" as NF_Docs <<NICE_TO_HAVE>>
  usecase "Inspect Advanced Telemetry" as NF_Telemetry <<NICE_TO_HAVE>>
}

Dev -- NF_Reproduce
Dev -- NF_Verify
Dev -- NF_OfflineAI
Dev -- NF_Docs
Operator -- NF_Access
Operator -- NF_OfflineAI
Operator -- NF_Degrade
Ops -- NF_Data
Ops -- NF_Health
Ops -- NF_Telemetry

note right of SystemBoundary
  <<constraint>>
  Module and hexagonal boundaries are preserved
  and mechanically verified where practical.
end note

note right of SystemBoundary
  <<constraint>>
  Local and remote deployments expose
  equivalent application topology.
end note

note bottom of NF_Verify
  Deterministic verification is executable evidence,
  not a manually maintained status claim.
end note
@enduml
