# Optional one-time host-local override. Keep the real value in .env.demo, which is ignored by Git.
# Use a hostname/IP that the browser running the demo can actually reach.
DEMO_HOST=<browser-reachable-host>
R0_PORT=8080
R1_PORT=8081

# Optional full-URL overrides if the browser-facing addresses need custom schemes/paths.
# R0_URL=http://<browser-reachable-host>:8080/
# R1_URL=http://<browser-reachable-host>:8081/
